    "@semantic-release/git": "11.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "20.9.0",
    "@typescript-eslint/eslint-plugin": "8.42.0",
    "@typescript-eslint/parser": "8.42.0",
    "autoprefixer": "10.4.21",

{
  "name": "webskills",
  "author": "Kommerz.App",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "format": "prettier . --check",
    "format:write": "prettier --write .",
    "lint": "ng lint && prettier . --check",
    "linting:write": "ng lint --fix",
    "test.ci": "pnpm test.ts-utils && pnpm test.logging && pnpm test.ng-utils && pnpm test.ng-components && pnpm test.webskills-demo",
    "test.ts-utils": "ng test ts-utils --no-watch --reporters=default --reporters=junit --output-file=junit/ts-utils.xml",
    "test.logging": "ng test logging --no-watch --reporters=default --reporters=junit --output-file=junit/logging.xml",
    "test.ng-utils": "ng test ng-utils --no-watch --reporters=default --reporters=junit --output-file=junit/ng-utils.xml",
    "test.ng-components": "ng test ng-components --no-watch --reporters=default --reporters=junit --output-file=junit/ng-components.xml",
    "build": "pnpm build.ts-utils && pnpm build.logging && pnpm build.ng-utils && pnpm build.ng-components",
    "build.ts-utils": "ng build ts-utils",
    "build.logging": "ng build logging",
    "build.ng-utils": "ng build ng-utils",
    "build.ng-components": "ng build ng-components",
    "build:watch.ng-components": "ng build ng-components --watch",
    "serve:demo": "ng serve webskills-demo --port 4202",
    "prepare": "husky",
    "test": "ng test",
    "test.webskills-demo": "ng test webskills-demo --no-watch --reporters=default --reporters=junit --output-file=junit/webskills-demo.xml"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.1",

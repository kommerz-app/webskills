    "@angular/language-service": "22.1.1",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "ng-packagr": "22.1.1",

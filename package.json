    "@angular/localize": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "fast-deep-equal": "3.1.3",
    "rfdc": "1.4.1",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1",
    "vega": "6.3.1",
    "vega-embed": "7.1.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.3",
